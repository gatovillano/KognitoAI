async def fetch_relevant_procedural_skills(
    user_message: str,
    account_id: Optional[str] = None,
    workspace_name: Optional[str] = None,
) -> List[Dict[str, Any]]:
    """
    Recupera las skills procedimentales relevantes para la consulta del usuario,
    combinando etiquetas explícitas con el símbolo '/' y búsqueda semántica en SKILL.md.
    """
    relevant_skills: List[Dict[str, Any]] = []
    seen_ids = set()

    if not user_message or not user_message.strip():
        return relevant_skills

    try:
        from core.skill_manager import get_skill_manager

        skill_mgr = get_skill_manager()

        # 1. Emparejamiento por tags explícitos (/code-review, etc.)
        tagged_matches = re.findall(r"(?:^|\s)/([a-zA-Z0-9_\-]+)", user_message)
        if tagged_matches:
            all_mds = await skill_mgr._load_skill_markdowns(account_id, workspace_name)
            id_to_skill = {}
            for s in all_mds:
                s_id = s.get("id", "")
                s_name = s.get("name", "")
                id_to_skill[s_id.lower()] = s
                id_to_skill[s_name.lower()] = s
                id_to_skill[s_id.replace("_skill", "").replace("-skill", "").lower()] = s

            for tag in tagged_matches:
                tag_clean = tag.lower().strip()
                if tag_clean in id_to_skill:
                    s = id_to_skill[tag_clean]
                    if s.get("id") not in seen_ids:
                        seen_ids.add(s.get("id"))
                        relevant_skills.append(s)

        # 2. Búsqueda semántica
        if len(user_message.strip()) > 3:
            semantic_results = await skill_mgr.search_skills_semantic(
                query=user_message,
                top_k=3,
                account_id=account_id,
                workspace_name=workspace_name,
            )
            for res in semantic_results:
                r_id = res.get("id")
                if r_id and r_id not in seen_ids:
                    seen_ids.add(r_id)
                    relevant_skills.append(res)
    except Exception as e:
        logger.warning(f"Error recuperando procedural skills: {e}")

    return relevant_skills


