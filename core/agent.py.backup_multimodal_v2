def is_multimodal_model(model_name: Optional[str]) -> bool:
    """
    Determina si un modelo soporta visión multimodal según su nombre.
    """
    if not model_name:
        return False
    indicators = [
        "gemini", "gpt-4o", "gpt-4-turbo", "gpt-4-vision", "claude-3",
        "claude-3-5", "vision", "pixtral", "llava", "bakllava", "nova-canvas",
        "nova-pro", "nova-lite", "qwen-vl", "qwen2.5-vl", "-vl", "deepseek-vl", "step-"
    ]
    name_lower = model_name.lower()
    return any(ind in name_lower for ind in indicators)


def normalize_image_url(url_or_base64: Optional[str]) -> str:
    """
    Normaliza URLs de imagen y datos Base64 asegurando el esquema data: URI.
    """
    if not url_or_base64:
        return ""
    url_str = str(url_or_base64).strip()
    if not url_str or url_str.startswith(("http://", "https://", "data:")):
        return url_str

    if url_str.startswith("iVBORw0KGgo"):
        mime = "image/png"
    elif url_str.startswith("/9j/"):
        mime = "image/jpeg"
    elif url_str.startswith("R0lGOD"):
        mime = "image/gif"
    elif url_str.startswith("UklGR"):
        mime = "image/webp"
    else:
        mime = "image/jpeg"
    return f"data:{mime};base64,{url_str}"


def sanitize_json_content(content: Any) -> Any:
    """
    Sanitiza el contenido para eliminar caracteres Unicode inválidos para PostgreSQL.
    """
    if isinstance(content, str):
        return "".join(c for c in content if ord(c) >= 32 or c in "\t\n\r")
    elif isinstance(content, dict):
        return {k: sanitize_json_content(v) for k, v in content.items()}
    elif isinstance(content, list):
        return [sanitize_json_content(item) for item in content]
    return content


def extract_text_content(content: Any) -> str:
    """
    Extrae texto plano de strings o listas multimodales estructuradas.
    """
    if isinstance(content, str):
        return content
    elif isinstance(content, list):
        text_parts = []
        for item in content:
            if isinstance(item, dict) and item.get("type") in {"text", "input_text"}:
                text_parts.append(item.get("text", ""))
            elif isinstance(item, str):
                text_parts.append(item)
        return "\n".join(text_parts).strip()
    return str(content) if content is not None else ""


def get_source_identifier(s: Union[Source, Dict[str, Any]]) -> str:
    """
    Genera una clave de identidad única para una fuente para evitar duplicados.
    """
    if hasattr(s, "model_dump"):
        s_dict = s.model_dump()
    elif hasattr(s, "dict"):
        s_dict = s.dict()
    elif isinstance(s, dict):
        s_dict = s
    else:
        return str(s)
    s_type = str(s_dict.get("type", "web"))
    s_url = str(s_dict.get("url") or s_dict.get("id") or "")
    s_title = str(s_dict.get("title") or "").strip().lower()
    s_snippet = str(s_dict.get("snippet") or "")[:80]
    return f"{s_type}::{s_url}::{s_title}::{s_snippet}"


def should_stop_retrying_tool(
    tool_name: str, tool_error_counts: Dict[str, int], max_retries: int = 3
) -> Tuple[bool, str]:
    """
    Verifica si una herramienta ha fallado demasiadas veces consecutivas.
    """
    count = tool_error_counts.get(tool_name, 0)
    if count >= max_retries:
        return True, f"La herramienta '{tool_name}' falló {count} veces consecutivas. Deteniendo reintentos."
    return False, ""


