class NativeAgentRunner:
    """
    Motor Agéntico Nativo Asíncrono de Alta Velocidad (KAI Fast Agent).
    Ejecuta el bucle de razonamiento y herramientas directamente con streaming en tiempo real,
    con indexación O(1) de herramientas y sin sobrecargas de serialización.
    """

    def __init__(self):
        self.prompt_manager = PromptManager(
            settings={"default_system_prompt": settings.default_system_prompt}
        )

    async def ainvoke(
        self, state: AgentState, config: Optional[RunnableConfig] = None
    ) -> Dict[str, Any]:
        """
        Ejecución sin streaming: consume el stream interno y retorna el estado final.
        """
        final_state = None
        async for chunk in self.astream(state, config=config):
            final_state = chunk
        return final_state or {
            "generateResponse": {"messages": state.get("messages", [])}
        }

    async def astream(self, state: AgentState, config: Optional[RunnableConfig] = None):
        """
        Ejecución ágil con streaming en tiempo real y función calling autónomo de alta velocidad.
        """
        configurable = (
            config.get("configurable", {})
            if isinstance(config, dict)
            else (getattr(config, "configurable", {}) or {})
        )
        account_id = state.get("account_id") or configurable.get("account_id")
        thread_id = state.get("thread_id") or configurable.get("thread_id")
        task_id = state.get("task_id") or configurable.get("task_id")
        telegram_id = state.get("telegram_id") or configurable.get("telegram_id")
        workspace_id = state.get("workspace_id") or configurable.get("workspace_id")
        rag_context = state.get("rag_context") or configurable.get("rag_context")
        context = state.get("context") or configurable.get("context")

        target_account_id = "telegram_bot_service" if telegram_id else account_id
        conn_type = "chat" if telegram_id else None

        messages: List[BaseMessage] = list(state.get("messages", []))
        if not messages:
            yield {"generateResponse": {"messages": []}}
            return

        last_human_message = next(
            (m for m in reversed(messages) if isinstance(m, HumanMessage)), None
        )
        user_message_text = (
            extract_text_content(last_human_message.content)
            if last_human_message
            else ""
        )

        # Helper para notificaciones websocket no bloqueantes
        def notify_ws_async(payload: Dict[str, Any]):
            if target_account_id:
                asyncio.create_task(
                    send_personal_message(target_account_id, payload, connection_type=conn_type)
                )

        async def agent_progress_callback(progress: int, message: str, current_node: str = "main"):
            payload = {
                "type": "progress",
                "progress": progress,
                "message": message,
                "current_node": current_node,
                "tool_name": "deep_research",
            }
            if thread_id:
                payload["thread_id"] = str(thread_id)
            if task_id:
                payload["taskId"] = str(task_id)
            notify_ws_async(payload)

        # ----------------------------------------------------------------------
        # CARGA CONCURRENTE DE LAS CAPAS DE MEMORIA Y DEPENDENCIAS
        # ----------------------------------------------------------------------
        # 1. Separar contexto explícito (OnlyOffice vs RAG)
        explicit_doc_ids = []
        has_onlyoffice_context = False
        extra_tool_categories = []

        if rag_context:
            for item in rag_context:
                item_type = str(item.get("type") or "").lower()
                item_topic = str(item.get("topic") or "").lower()
                item_name = str(item.get("name") or "")
                if (
                    item_type in ("onlyoffice", "onlyoffice_document")
                    or item_topic == "onlyoffice"
                    or item_name.startswith("[OnlyOffice]")
                ):
                    has_onlyoffice_context = True
                elif item_type == "document" and item.get("id"):
                    explicit_doc_ids.append(item["id"])

        if has_onlyoffice_context:
            extra_tool_categories.append("onlyoffice_skill")

        # 2. Cargar workspace si aplica
        workspace_name = None
        workspace_prompt = None
        if workspace_id:
            try:
                async with DBSession(SessionLocal) as db:
                    ws = await db.get(Workspace, uuid.UUID(workspace_id))
                    if ws:
                        workspace_name = ws.name
                        if ws.system_prompt:
                            workspace_prompt = str(ws.system_prompt)
            except Exception as e:
                logger.warning(f"Error cargando workspace {workspace_id}: {e}")

        # 3. Disparo concurrente de todas las capas de memoria
        # Capa 1: Perfil de usuario
        user_profile_task = get_user_profile(account_id)
        # Capa LLM
        llm_task = get_llm_for_user(account_id, purpose="main")
        # Herramientas del agente
        tools_task = get_all_langchain_tools(
            account_id=account_id,
            telegram_id=telegram_id,
            thread_id=thread_id,
            workspace_id=workspace_id,
            progress_callback=agent_progress_callback,
            query=user_message_text,
            extra_categories=extra_tool_categories or None,
        )
        # Capa 5: Memoria procedimental / skills
        skills_task = fetch_relevant_procedural_skills(
            user_message_text, account_id=account_id, workspace_name=workspace_name
        )
        # Capa 3: Memoria episódica / semántica RAG
        rag_task = None
        if explicit_doc_ids or (len(user_message_text.strip()) > 10):
            rag_task = get_relevant_memories(
                account_id=account_id,
                query=user_message_text,
                workspace_id=workspace_id,
                explicit_document_ids=explicit_doc_ids or None,
                k=8,
            )

        gather_tasks = [user_profile_task, llm_task, tools_task, skills_task]
        if rag_task:
            gather_tasks.append(rag_task)

        results = await asyncio.gather(*gather_tasks, return_exceptions=True)

        user_profile = results[0] if not isinstance(results[0], Exception) else None
        llm = results[1] if not isinstance(results[1], Exception) else None
        toolbox = results[2] if not isinstance(results[2], Exception) and results[2] else []
        relevant_procedural_skills = (
            results[3] if not isinstance(results[3], Exception) and results[3] else []
        )
        rag_output = (
            results[4] if len(results) > 4 and not isinstance(results[4], Exception) else None
        )

        if not llm:
            llm = get_main_llm()
        if not llm:
            raise ValueError(f"No hay ningún LLM configurado o disponible para account_id={account_id}.")

        # 4. Formatear fuentes RAG para System Prompt
        sources_list: List[Source] = []
        seen_source_ids = set()
        relevant_memories_text = ""

        def _register_source(src: Union[Source, Dict[str, Any]]) -> Optional[Source]:
            try:
                if isinstance(src, dict):
                    src_obj = Source(**src)
                elif isinstance(src, Source):
                    src_obj = src
                else:
                    return None
            except Exception as e:
                logger.warning(f"Error parseando fuente para LLM: {e}")
                return None
            ident = get_source_identifier(src_obj)
            if ident not in seen_source_ids:
                seen_source_ids.add(ident)
                sources_list.append(src_obj)
                return src_obj
            return None

        if rag_output and hasattr(rag_output, "sources") and rag_output.sources:
            for s in rag_output.sources:
                s_dict = (
                    s.model_dump()
                    if hasattr(s, "model_dump")
                    else (s.dict() if hasattr(s, "dict") else s)
                )
                if isinstance(s_dict, dict):
                    _register_source(s_dict)
            relevant_memories_text = format_context_with_sources(sources_list)

        # Fallback a chunks explícitos si se especificaron documentos y no hubo match RAG
        if not sources_list and explicit_doc_ids:
            fallback_chunks = await get_document_chunks(
                account_id=account_id,
                document_ids=explicit_doc_ids,
                limit=8,
                workspace_id=workspace_id,
            )
            if fallback_chunks:
                for i, doc in enumerate(fallback_chunks, start=1):
                    _register_source(
                        Source(
                            id=i,
                            title=doc.metadata.get("file_name", "Documento"),
                            url=doc.metadata.get("document_id", ""),
                            snippet=doc.page_content[:400],
                            type=SourceType.DOCUMENT,
                        )
                    )
                relevant_memories_text = format_context_with_sources(sources_list)

        # 5. Capa 1 y 4: Construir System Prompt consolidado
        custom_prompt = (
            str(user_profile.system_prompt)
            if user_profile and getattr(user_profile, "system_prompt", None)
            else None
        )

        system_prompt_content = self.prompt_manager.build_system_prompt(
            user_profile=user_profile,
            relevant_memories=relevant_memories_text or "No se encontraron memorias específicas.",
            summary_string="",
            custom_prompt_from_profile=custom_prompt,
            workspace_prompt=workspace_prompt,
            tools=toolbox,
            account_id=account_id,
            telegram_id=telegram_id,
            user_message=user_message_text,
            has_explicit_rag_context=bool(rag_context),
            explicit_rag_context_items=rag_context,
            context=context,
            relevant_skills=relevant_procedural_skills,
        )

        system_message = SystemMessage(content=system_prompt_content)

        # ----------------------------------------------------------------------
        # OPTIMIZACIÓN DE HERRAMIENTAS: INDEXACIÓN O(1) Y CACHÉ DE ESQUEMAS
        # ----------------------------------------------------------------------
        tools_by_name: Dict[str, BaseTool] = {}
        openai_tools: List[Dict[str, Any]] = []

        for t in toolbox:
            if not isinstance(t, BaseTool):
                continue
            t_name = getattr(t, "name", "")
            if not t_name:
                continue
            tools_by_name[t_name] = t
            # Alias normalizado: los LLMs a veces devuelven guiones bajos
            # en lugar de guiones (emcp_tools_... vs emcp-tools-...).
            norm = t_name.replace("-", "_")
            if norm != t_name and norm not in tools_by_name:
                tools_by_name[norm] = t

            # Usar caché de esquemas para evitar reflexión repetitiva
            cached_schema = _TOOL_SCHEMA_CACHE.get(t_name)
            if cached_schema is not None:
                openai_tools.append(cached_schema)
            else:
                try:
                    schema = convert_to_openai_tool(t)
                    _TOOL_SCHEMA_CACHE[t_name] = schema
                    openai_tools.append(schema)
                except Exception as conv_err:
                    logger.warning(f"Error generando esquema para herramienta '{t_name}': {conv_err}")

        # Vinculación de herramientas al LLM
        if openai_tools:
            try:
                llm_with_tools = llm.bind(tools=openai_tools, tool_choice="auto")
            except Exception:
                llm_with_tools = llm.bind(tools=openai_tools)
        else:
            llm_with_tools = llm

        # ----------------------------------------------------------------------
        # BUCLE AGÉNTICO NATIVO Y DISPATCH DE HERRAMIENTAS
        # ----------------------------------------------------------------------
        configured_max = getattr(settings, "max_agent_loops", 0)
        is_unlimited = configured_max is None or configured_max <= 0
        max_loops = 1000 if is_unlimited else configured_max
        loop_count = 0
        final_ai_message = None

        run_config = RunnableConfig(
            configurable={
                "account_id": account_id,
                "workspace_id": workspace_id,
                "telegram_id": telegram_id,
                "thread_id": str(thread_id) if thread_id else None,
                "task_id": str(task_id) if task_id else None,
                "progress_callback": agent_progress_callback,
            },
            metadata={
                "account_id": account_id,
                "workspace_id": workspace_id,
                "telegram_id": telegram_id,
                "thread_id": str(thread_id) if thread_id else None,
                "task_id": str(task_id) if task_id else None,
            },
        )

        while loop_count < max_loops:
            loop_count += 1
            cleaned_history = [m for m in messages if not isinstance(m, SystemMessage)]
            full_turn_messages = [system_message] + cleaned_history

            full_ai_content = ""
            full_reasoning_content = ""
            raw_tool_calls_map: Dict[Union[int, str], Dict[str, Any]] = {}
            tool_calls_from_llm = []

            try:
                async for chunk in llm_with_tools.astream(full_turn_messages):
                    if not isinstance(chunk, AIMessage):
                        continue

                    # A. Razonamiento / Thinking
                    add_kwargs = getattr(chunk, "additional_kwargs", {}) or {}
                    resp_meta = getattr(chunk, "response_metadata", {}) or {}
                    reasoning_chunk = ""
                    for k in ("reasoning", "reasoning_content", "thought", "thinking", "reflection"):
                        if k in add_kwargs and isinstance(add_kwargs[k], str):
                            reasoning_chunk = add_kwargs[k]
                            break
                        if k in resp_meta and isinstance(resp_meta[k], str):
                            reasoning_chunk = resp_meta[k]
                            break

                    if reasoning_chunk:
                        full_reasoning_content += reasoning_chunk
                        notify_ws_async(
                            {
                                "type": "reasoning_chunk",
                                "thread_id": thread_id,
                                "taskId": task_id,
                                "chunk": reasoning_chunk,
                                "full_reasoning": full_reasoning_content,
                            }
                        )

                    # B. Texto del stream
                    current_text = ""
                    if isinstance(chunk.content, str):
                        current_text = chunk.content
                    elif isinstance(chunk.content, list):
                        for p in chunk.content:
                            if isinstance(p, dict) and p.get("type") == "text":
                                current_text += p.get("text", "")

                    if current_text:
                        full_ai_content += current_text
                        notify_ws_async(
                            {
                                "type": "stream_chunk",
                                "thread_id": thread_id,
                                "taskId": task_id,
                                "chunk": current_text,
                                "full_text": full_ai_content,
                            }
                        )

                    # C. Acumulación ligera de tool_call_chunks (sin parsing JSON por token)
                    if hasattr(chunk, "tool_call_chunks") and chunk.tool_call_chunks:
                        for tc_chunk in chunk.tool_call_chunks:
                            key = tc_chunk.get("index")
                            if key is None:
                                key = tc_chunk.get("id") or len(raw_tool_calls_map)

                            if key not in raw_tool_calls_map:
                                raw_tool_calls_map[key] = {
                                    "name": tc_chunk.get("name") or "",
                                    "args_parts": [],
                                    "id": tc_chunk.get("id") or str(uuid.uuid4()),
                                }
                            entry = raw_tool_calls_map[key]
                            if tc_chunk.get("name"):
                                entry["name"] = tc_chunk["name"]
                            if tc_chunk.get("id"):
                                entry["id"] = tc_chunk["id"]
                            if tc_chunk.get("args"):
                                entry["args_parts"].append(tc_chunk["args"])

                    elif getattr(chunk, "tool_calls", None):
                        for tc in chunk.tool_calls:
                            tool_calls_from_llm.append(tc)

            except Exception as stream_err:
                logger.error(f"❌ Error durante streaming del LLM: {stream_err}", exc_info=True)
                # Fallback a ainvoke no-stream si el streaming se interrumpe
                try:
                    non_stream_res = await llm_with_tools.ainvoke(full_turn_messages)
                except Exception as invoke_err:
                    logger.warning(f"⚠️ Reintento no-stream falló con el LLM principal: {invoke_err}. Usando fallback...")
                    fallback_llm = await get_configured_fallback_llm(account_id, failed_purpose="main")
                    if fallback_llm and fallback_llm != llm:
                        fb_with_tools = fallback_llm.bind(tools=openai_tools) if openai_tools else fallback_llm
                        non_stream_res = await fb_with_tools.ainvoke(full_turn_messages)
                    else:
                        raise invoke_err

                if isinstance(non_stream_res, AIMessage):
                    full_ai_content = extract_text_content(non_stream_res.content)
                    tool_calls_from_llm = list(getattr(non_stream_res, "tool_calls", []) or [])
                    if full_ai_content:
                        notify_ws_async(
                            {
                                "type": "stream_chunk",
                                "thread_id": thread_id,
                                "taskId": task_id,
                                "chunk": full_ai_content,
                                "full_text": full_ai_content,
                            }
                        )

            # Consolidar tool calls acumuladas: parsing JSON en UNA sola pasada
            valid_tool_calls = []

            # 1. De los chunks fragmentados
            for item in raw_tool_calls_map.values():
                name = item.get("name")
                if not name:
                    continue
                args_str = "".join(item.get("args_parts", "")).strip()
                parsed_args = {}
                if args_str:
                    try:
                        parsed_args = json.loads(args_str)
                    except Exception:
                        try:
                            # Intento de rescate si hay caracteres basura
                            match = re.search(r"\{.*\}", args_str, re.DOTALL)
                            if match:
                                parsed_args = json.loads(match.group(0))
                        except Exception:
                            parsed_args = {}
                valid_tool_calls.append(
                    {
                        "name": name,
                        "args": parsed_args if isinstance(parsed_args, dict) else {},
                        "id": item.get("id") or str(uuid.uuid4()),
                    }
                )

            # 2. De llamadas completas directas
            for tc in tool_calls_from_llm:
                tc_name = tc.get("name")
                if not tc_name:
                    continue
                tc_args = tc.get("args") or {}
                if isinstance(tc_args, str):
                    try:
                        tc_args = json.loads(tc_args)
                    except Exception:
                        tc_args = {}
                # Evitar duplicados
                if not any(v["id"] == tc.get("id") for v in valid_tool_calls):
                    valid_tool_calls.append(
                        {
                            "name": tc_name,
                            "args": tc_args if isinstance(tc_args, dict) else {},
                            "id": tc.get("id") or str(uuid.uuid4()),
                        }
                    )

            # ------------------------------------------------------------------
            # EJECUCIÓN CONCURRENTE O(1) DE HERRAMIENTAS
            # ------------------------------------------------------------------
            if valid_tool_calls:
                logger.info(
                    f"🧰 FastNativeAgent: Ejecutando {len(valid_tool_calls)} herramientas concurrentes"
                )

                ai_msg = AIMessage(
                    content=full_ai_content,
                    tool_calls=valid_tool_calls,
                    additional_kwargs={"reasoning": full_reasoning_content}
                    if full_reasoning_content
                    else {},
                )
                messages.append(ai_msg)

                async def _execute_single(tc: Dict[str, Any]) -> ToolMessage:
                    tool_name = tc["name"]
                    tool_args = tc.get("args") or {}
                    tool_id = tc["id"]

                    notify_ws_async(
                        {
                            "type": "tool_start",
                            "taskId": task_id,
                            "tool_name": tool_name,
                            "thread_id": thread_id,
                        }
                    )

                    # Búsqueda instantánea O(1) (+ alias guion/guion-bajo)
                    selected_tool = tools_by_name.get(tool_name)
                    if not selected_tool:
                        selected_tool = tools_by_name.get(tool_name.replace("-", "_"))
                    if not selected_tool:
                        selected_tool = tools_by_name.get(tool_name.replace("_", "-"))
                    if not selected_tool:
                        # Fallback a get_tool_by_name si no estaba indexada
                        selected_tool = await get_tool_by_name(
                            tool_name=tool_name,
                            all_tools=toolbox,
                            account_id=account_id,
                            telegram_id=str(telegram_id) if telegram_id else None,
                            workspace_id=workspace_id,
                        )

                    if not selected_tool:
                        err_res = f"Error: Herramienta '{tool_name}' no encontrada."
                        notify_ws_async(
                            {
                                "type": "tool_end",
                                "taskId": task_id,
                                "tool_name": tool_name,
                                "status": "error",
                                "result": err_res,
                                "error": True,
                            }
                        )
                        return ToolMessage(content=err_res, tool_call_id=tool_id)

                    # Inyectar propiedades contextuales si la herramienta las soporta
                    if hasattr(selected_tool, "thread_id") and not getattr(selected_tool, "thread_id", None):
                        selected_tool.thread_id = str(thread_id) if thread_id else None
                    if hasattr(selected_tool, "task_id") and not getattr(selected_tool, "task_id", None):
                        selected_tool.task_id = str(task_id) if task_id else None
                    if hasattr(selected_tool, "progress_callback") and not getattr(selected_tool, "progress_callback", None):
                        selected_tool.progress_callback = agent_progress_callback

                    try:
                        async with _TOOL_EXECUTION_SEMAPHORE:
                            out = await selected_tool.ainvoke(tool_args, config=run_config)

                        tool_sources: List[Source] = []
                        if isinstance(out, ToolOutputWithSources):
                            out_str = out.context_for_llm
                            if out.sources:
                                tool_sources = out.sources
                        elif isinstance(out, dict):
                            out_str = (
                                out.get("context_for_llm")
                                or json.dumps(out, ensure_ascii=False)
                            )
                            raw_s = out.get("sources")
                            if raw_s and isinstance(raw_s, list):
                                for s in raw_s:
                                    if isinstance(s, Source):
                                        tool_sources.append(s)
                                    elif isinstance(s, dict):
                                        try:
                                            tool_sources.append(Source(**s))
                                        except Exception:
                                            pass
                        elif isinstance(out, list):
                            # [PATCH MULTIMODAL] Preservar content blocks (texto + imagen)
                            # desde tools MCP que devuelven ImageContent (screenshots, etc.)
                            _has_image_block = any(
                                isinstance(item, dict) and item.get("type") == "image"
                                for item in out
                            )
                            if _has_image_block:
                                # Normalizar bloques de imagen al formato LangChain
                                _multimodal_blocks: List[Any] = []
                                for item in out:
                                    if isinstance(item, dict) and item.get("type") == "image":
                                        _img_data = item.get("data") or item.get("base64") or ""
                                        _mime = item.get("mimeType") or item.get("mime_type") or "image/png"
                                        if _img_data:
                                            _multimodal_blocks.append({
                                                "type": "image_url",
                                                "image_url": {
                                                    "url": f"data:{_mime};base64,{_img_data}"
                                                },
                                            })
                                    elif isinstance(item, dict) and item.get("type") == "text":
                                        _multimodal_blocks.append({
                                            "type": "text",
                                            "text": item.get("text", ""),
                                        })
                                    elif isinstance(item, str):
                                        _multimodal_blocks.append({"type": "text", "text": item})
                                if _multimodal_blocks:
                                    out_str = _multimodal_blocks
                                else:
                                    out_str = json.dumps(out, ensure_ascii=False)
                            else:
                                out_str = json.dumps(out, ensure_ascii=False)
                        else:
                            out_str = str(out)

                        # Registrar fuentes de la herramienta a la lista acumulada
                        for s in tool_sources:
                            s_dict = (
                                s.model_dump()
                                if hasattr(s, "model_dump")
                                else (s.dict() if hasattr(s, "dict") else s)
                            )
                            ident = get_source_identifier(s_dict)
                            if ident not in seen_source_ids:
                                seen_source_ids.add(ident)
                                s_dict["id"] = len(sources_list) + 1
                                sources_list.append(Source(**s_dict))

                        notify_ws_async(
                            {
                                "type": "tool_end",
                                "taskId": task_id,
                                "tool_name": tool_name,
                                "status": "success",
                                "result": (
                                    out_str[:1500]
                                    if isinstance(out_str, str)
                                    else json.dumps(out_str, ensure_ascii=False)[:1500]
                                ),
                                "sources": [
                                    s.model_dump() if hasattr(s, "model_dump") else (s.dict() if hasattr(s, "dict") else s)
                                    for s in tool_sources
                                ],
                            }
                        )
                        tool_msg = ToolMessage(content=out_str, tool_call_id=tool_id)
                        if tool_sources:
                            tool_msg.additional_kwargs["sources"] = [
                                s.model_dump() if hasattr(s, "model_dump") else (s.dict() if hasattr(s, "dict") else s)
                                for s in tool_sources
                            ]
                        return tool_msg

                    except Exception as t_err:
                        logger.error(f"Error ejecutando '{tool_name}': {t_err}", exc_info=True)
                        err_msg = f"Error ejecutando '{tool_name}': {str(t_err)}"
                        notify_ws_async(
                            {
                                "type": "tool_end",
                                "taskId": task_id,
                                "tool_name": tool_name,
                                "status": "error",
                                "result": err_msg,
                                "error": True,
                            }
                        )
                        return ToolMessage(content=err_msg, tool_call_id=tool_id)

                # Ejecutar todas las herramientas concurrentemente
                tool_results = await asyncio.gather(
                    *[_execute_single(tc) for tc in valid_tool_calls],
                    return_exceptions=False,
                )
                for t_res in tool_results:
                    messages.append(t_res)

                # Siguiente turno para que el LLM sintetice los resultados
                continue

            else:
                # No hay llamadas a herramientas -> Respuesta final completada
                sources_dump = [
                    s.model_dump() if hasattr(s, "model_dump") else (s.dict() if hasattr(s, "dict") else s)
                    for s in sources_list
                ]
                additional_kwargs: Dict[str, Any] = {}
                if full_reasoning_content:
                    additional_kwargs["reasoning"] = full_reasoning_content
                if sources_dump:
                    additional_kwargs["sources"] = sources_dump

                final_ai_message = AIMessage(
                    content=full_ai_content,
                    additional_kwargs=additional_kwargs,
                )
                messages.append(final_ai_message)
                break

        # Si se agotaron los loops máximos sin mensaje final, forzar síntesis
        if final_ai_message is None:
            logger.warning(
                f"⚠️ NativeAgentRunner: Se alcanzaron las {max_loops} iteraciones máximas. Forzando síntesis."
            )
            cleaned_history = [m for m in messages if not isinstance(m, SystemMessage)]
            synth_messages = [system_message] + cleaned_history
            try:
                synth_ai = await llm.ainvoke(synth_messages)
                if isinstance(synth_ai, AIMessage):
                    sources_dump = [
                        s.model_dump() if hasattr(s, "model_dump") else (s.dict() if hasattr(s, "dict") else s)
                        for s in sources_list
                    ]
                    if sources_dump:
                        synth_ai.additional_kwargs["sources"] = sources_dump
                    messages.append(synth_ai)
                    final_ai_message = synth_ai
                    final_text = extract_text_content(synth_ai.content)
                    if final_text:
                        notify_ws_async(
                            {
                                "type": "stream_chunk",
                                "thread_id": thread_id,
                                "taskId": task_id,
                                "chunk": final_text,
                                "full_text": final_text,
                            }
                        )
            except Exception as synth_err:
                logger.error(f"❌ Error generando síntesis final del agente: {synth_err}")

        sources_dump = [
            s.model_dump() if hasattr(s, "model_dump") else (s.dict() if hasattr(s, "dict") else s)
            for s in sources_list
        ]
        # Emitir estado final estructurado compatible con api/chat.py
        yield {
            "generateResponse": {
                "messages": messages,
                "account_id": account_id,
                "thread_id": thread_id,
                "task_id": task_id,
                "sources": sources_dump,
            }
        }


# ==============================================================================
# SINGLETON DEL AGENTE Y PUNTO DE ENTRADA
# ==============================================================================

_native_agent_singleton: Optional[NativeAgentRunner] = None


def get_langgraph_agent() -> NativeAgentRunner:
    """
    Retorna la instancia singleton del agente de KAI.
    Conserva el nombre histórico 'get_langgraph_agent' para compatibilidad total
    con api/chat.py y otros módulos del sistema.
    """
    global _native_agent_singleton
    if _native_agent_singleton is None:
        logger.info("⚡ Inicializando FastNativeAgentRunner...")
        _native_agent_singleton = NativeAgentRunner()
    return _native_agent_singleton


get_native_agent = get_langgraph_agent


