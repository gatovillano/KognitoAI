async def run_custom_user_heartbeat(
    account_id: str,
    heartbeat_id: str,
    heartbeat_name: str,
    instructions: str,
    workspace_id: Optional[str] = None,
) -> str:
    """
    Ejecuta un ciclo de Heartbeat Personalizado en segundo plano para el usuario.
    """
    logger.info(f"Iniciando ciclo de heartbeat '{heartbeat_name}' para cuenta {account_id}...")
    agent_app = get_native_agent()

    thread_id = await get_or_create_specific_heartbeat_thread(
        account_id, heartbeat_id, heartbeat_name
    )

    initial_human_message = HumanMessage(
        content=(
            f"--- INSTRUCCIÓN DE HEARTBEAT PERSONALIZADO: '{heartbeat_name}' ---\n"
            f"{instructions}\n"
            f"REGLA: Ejecuta las acciones necesarias proactivamente usando tus herramientas."
        )
    )

    initial_state: AgentState = {
        "messages": [initial_human_message],
        "account_id": account_id,
        "task_id": f"hb_{uuid.uuid4().hex[:8]}",
        "telegram_id": None,
        "workspace_id": workspace_id,
        "rag_context": None,
        "sources": [],
        "thread_id": thread_id,
        "context": {"type": "custom_heartbeat"},
        "loop_count": 0,
        "turn_count": 0,
    }

    try:
        final_state = await agent_app.ainvoke(initial_state)
        final_messages = (
            final_state.get("generateResponse", {}).get("messages", [])
            if final_state
            else []
        )
        final_ai = next(
            (m for m in reversed(final_messages) if isinstance(m, AIMessage)), None
        )
        if final_ai:
            return f"Heartbeat '{heartbeat_name}' completado: {extract_text_content(final_ai.content)[:200]}..."
        return "Heartbeat completado sin respuesta explícita."
    except Exception as e:
        logger.error(f"Error en run_custom_user_heartbeat: {e}", exc_info=True)
        return f"Error: {e}"
