async def summarize_history_in_background(
    history_to_summarize: List[BaseMessage],
    chat_message_history: PostgresChatMessageHistory,
    account_id: str,
    workspace_id: Optional[str] = None,
):
    """
    Resume mensajes en segundo plano y añade el resumen a la base vectorial.
    """
    llm = await get_llm_for_user(account_id, purpose="fast")
    if not llm:
        return
    try:
        conversation_text = "\n".join(
            [
                f"{'Usuario' if isinstance(m, HumanMessage) else 'Asistente'}: {extract_text_content(m.content)}"
                for m in history_to_summarize
            ]
        )
        prompt = f"{SUMMARIZATION_PROMPT}\n\nHistorial a resumir:\n{conversation_text}"
        res = await llm.ainvoke(prompt)
        summary_content = str(res.content) if hasattr(res, "content") else str(res)

        summary_msg = HumanMessage(
            content=f"Resumen de la conversación anterior: {summary_content}",
            additional_kwargs={"role": "summary"},
        )
        await chat_message_history.aadd_messages([summary_msg])
        await add_memory_to_vector_db(
            account_id=account_id,
            content=summary_content,
            type="thread_summary",
            workspace_id=workspace_id,
        )
    except Exception as e:
        logger.error(f"Error en sumarización en segundo plano: {e}")


