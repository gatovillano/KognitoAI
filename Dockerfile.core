# Dockerfile.core
# Construye la imagen para el servicio 'core'.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# ¡IMPORTANTE! Instala TODAS las dependencias del sistema necesarias.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Usa el archivo de requerimientos unificado.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Ejecuta el lanzador de la API.
CMD ["uvicorn", "run_api:app", "--host", "0.0.0.0", "--port", "8000"]