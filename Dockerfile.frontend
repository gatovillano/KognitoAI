# Dockerfile.frontend
# Construye la imagen para el servicio de frontend estático usando Nginx.

# 1. Usar una imagen oficial y ligera de Nginx.
FROM nginx:1.25-alpine

# 2. Copiar nuestra configuración personalizada de Nginx.
# Esto sobreescribe la configuración por defecto.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 3. Copiar los archivos de nuestra aplicación web (HTML, CSS, JS, assets).
# Los copia a la carpeta que Nginx está configurado para servir.
COPY public_chat_ui/ /usr/share/nginx/html