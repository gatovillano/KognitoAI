# En: Dockerfile.frontend

# --- Etapa 1: Builder ---
# Usamos una imagen de Node.js para construir la aplicación.
FROM node:18-alpine AS builder

# Establecemos el directorio de trabajo dentro del contenedor
WORKDIR /app

# Copiamos package.json y package-lock.json (o pnpm-lock.yaml si usas pnpm)
COPY package*.json ./
# Si usas pnpm, descomenta la siguiente línea y comenta la de npm
# COPY pnpm-lock.yaml ./
# RUN npm install -g pnpm

# Instalamos las dependencias
RUN npm install
# Si usas pnpm: RUN pnpm install

# Copiamos el resto del código de la aplicación
COPY . .

# Construimos la aplicación para producción.
# NEXT_PUBLIC_API_URL es una variable de entorno que pasaremos desde docker-compose.
# Esto le dice a Next.js cuál es la URL de tu backend.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN npm run build

# --- Etapa 2: Runner ---
# Usamos una imagen más ligera para ejecutar la aplicación ya construida.
FROM node:18-alpine AS runner

WORKDIR /app

# Copiamos solo los archivos necesarios de la etapa 'builder'
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

# Exponemos el puerto 3000 (el puerto por defecto de Next.js)
EXPOSE 3000

# El comando para iniciar el servidor de Next.js en producción
CMD ["npm", "start"]