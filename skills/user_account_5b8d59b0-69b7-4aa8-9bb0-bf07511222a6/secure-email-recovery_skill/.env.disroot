# ==============================================================================
# CONFIGURACIÓN DISROOT - EMAIL RECOVERY SKILL
# ==============================================================================
# 📧 Proveedor: Disroot.org (Correo electrónico ético y descentralizado)
# 🔒 Método: Contraseña de aplicación (App Password) o contraseña normal
# 📚 Documentación oficial: https://howto.disroot.org/en/tutorials/email/settings

# ------------------------------------------------------------------------------
# CREDENCIALES DISROOT
# ------------------------------------------------------------------------------
# Tu dirección de correo Disroot
DISROOT_EMAIL_ADDRESS=tu_usuario@disroot.org

# Contraseña de tu cuenta Disroot
# ⚠️  Recomendado: Usa una contraseña de aplicación si tienes 2FA activado
# Generar en: https://disroot.org → Settings → Email → App Passwords
DISROOT_EMAIL_PASSWORD=tu_contraseña_aqui

# ------------------------------------------------------------------------------
# CONFIGURACIÓN IMAP DISROOT (Confirmada por documentación oficial)
# ------------------------------------------------------------------------------
# Servidor IMAP: disroot.org (NO imap.disroot.org)
DISROOT_IMAP_SERVER=disroot.org
DISROOT_IMAP_PORT=993
DISROOT_IMAP_USE_SSL=true
DISROOT_IMAP_ENCRYPTION=SSL/TLS

# ------------------------------------------------------------------------------
# CONFIGURACIÓN SMTP DISROOT (Para envío de correos)
# ------------------------------------------------------------------------------
DISROOT_SMTP_SERVER=disroot.org
DISROOT_SMTP_PORT=587
DISROOT_SMTP_USE_TLS=true
DISROOT_SMTP_ENCRYPTION=STARTTLS

# ------------------------------------------------------------------------------
# CONFIGURACIÓN AVANZADA
# ------------------------------------------------------------------------------
# Tiempo de vida del cache en segundos (default: 300 = 5 minutos)
EMAIL_CACHE_TTL=300

# Tamaño máximo de cache
EMAIL_CACHE_MAXSIZE=1000

# Timeout de conexión en segundos
EMAIL_CONNECTION_TIMEOUT=30

# Número máximo de reintentos
EMAIL_MAX_RETRIES=3

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
EMAIL_LOG_LEVEL=INFO

# Habilitar/deshabilitar cache
EMAIL_CACHE_ENABLED=true

# ==============================================================================
# INSTRUCCIONES DE USO
# ==============================================================================
# 1. Copia este archivo como .env:
#    cp .env.disroot .env
#
# 2. Edita .env con tus credenciales reales:
#    - DISROOT_EMAIL_ADDRESS: tu_usuario@disroot.org
#    - DISROOT_EMAIL_PASSWORD: tu_contraseña_o_app_password
#
# 3. Uso en Python:
#    from secure_email_recovery import EmailRecovery
#    client = EmailRecovery(provider="disroot")
#    emails = client.get_recent_emails(limit=10)
#
# 4. Uso en CLI:
#    python secure_email-recovery.py --provider disroot --limit 10
# ==============================================================================
