# =============================================================================
# Secure Email Recovery - Configuración de Variables de Entorno
# =============================================================================
# Copia este archivo como '.env' y completa con tus credenciales.
# NUNCA COMMITEES EL ARCHIVO .env A REPOSITORIOS.

# -----------------------------------------------------------------------------
# DISROOT (Configuración Recomendada)
# -----------------------------------------------------------------------------
# Disroot usa contraseña de aplicación (no tu contraseña principal).
# Genera una en: https://disroot.org/es/panel -> Correo -> Contraseñas de aplicación
DISROOT_PASSWORD=tu_contraseña_de_aplicacion_disroot

# -----------------------------------------------------------------------------
# GMAIL (OAuth2 - Opcional)
# -----------------------------------------------------------------------------
# Pasos para configurar OAuth2:
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea credenciales de tipo 'Aplicación de escritorio'
# 3. Habilita la API de Gmail
# 4. Genera un refresh token usando el flujo OAuth2
#
# GOOGLE_CLIENT_ID=tu_client_id
# GOOGLE_CLIENT_SECRET=tu_client_secret
# GMAIL_REFRESH_TOKEN=tu_refresh_token
# GMAIL_ACCESS_TOKEN=tu_access_token
# GMAIL_TOKEN_EXPIRY=2024-12-31T23:59:59

# -----------------------------------------------------------------------------
# OUTLOOK / OFFICE 365 (OAuth2 - Opcional)
# -----------------------------------------------------------------------------
# Pasos para configurar OAuth2:
# 1. Ve a https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsList
# 2. Registra una nueva aplicación
# 3. Agrega permiso IMAP.AccessAsUser.All
# 4. Genera un refresh token
#
# OUTLOOK_CLIENT_ID=tu_client_id
# OUTLOOK_CLIENT_SECRET=tu_client_secret
# OUTLOOK_REFRESH_TOKEN=tu_refresh_token
# OUTLOOK_ACCESS_TOKEN=tu_access_token
# OUTLOOK_TOKEN_EXPIRY=2024-12-31T23:59:59

# -----------------------------------------------------------------------------
# YAHOO (OAuth2 - Opcional)
# -----------------------------------------------------------------------------
# YAHOO_CLIENT_ID=tu_client_id
# YAHOO_CLIENT_SECRET=tu_client_secret
# YAHOO_REFRESH_TOKEN=tu_refresh_token
# YAHOO_ACCESS_TOKEN=tu_access_token
# YAHOO_TOKEN_EXPIRY=2024-12-31T23:59:59

# -----------------------------------------------------------------------------
# CONFIGURACIÓN GENERAL
# -----------------------------------------------------------------------------
# Directorio por defecto para guardar adjuntos
DEFAULT_ATTACHMENT_DIR=./adjuntos

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
