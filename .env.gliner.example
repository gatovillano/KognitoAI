# ======================================
# 🎯 CONFIGURACIÓN DE GLINER (NER MEJORADO)
# ======================================

# Activar GLiNER para extracción de entidades mejorada
# True: Usa GLiNER (más preciso, ~2-3x más lento)
# False: Usa solo spaCy (más rápido, menos preciso)
USE_GLINER=True

# Tamaño del modelo GLiNER
# small: ~250MB, rápido, buena precisión (RECOMENDADO)
# base: ~500MB, balance óptimo
# large: ~1GB, máxima precisión
GLINER_MODEL_SIZE=small

# Modo híbrido: combina spaCy (rápido) + GLiNER (preciso)
# True: Usa ambos modelos para mejor cobertura (RECOMENDADO)
# False: Usa solo el modelo activo (GLiNER o spaCy)
USE_HYBRID_NER=True

# Umbral de confianza para GLiNER (0.0-1.0)
# Más alto = menos entidades pero mayor precisión
# Más bajo = más entidades pero puede incluir ruido
# Recomendado: 0.6
GLINER_THRESHOLD=0.6
