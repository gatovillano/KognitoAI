73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[8;112H\r\n\u001b[9;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33msu tamaño original. Primero necesito:                                                       \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[9;112H\r\n\u001b[10;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m                                                                                            \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[10;112H\r\n\u001b[11;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;66;146;166;48;2;25;26;33m 1 \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33mLeer el archivo Cambios.md para ver el contexto                                          \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[11;112H\r\n\u001b[12;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;66;146;166;48;2;25;26;33m 2 \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33mEntender qué es un archivo .cast (generalmente son archivos de asciinema para grabaciones\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[12;112H\r\n\u001b[13;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;66;146;166;48;2;25;26;33m   \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33mde terminal)                                                                             \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u0