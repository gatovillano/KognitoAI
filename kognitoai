#!/usr/bin/env bash
# kognitoai - Global CLI for managing Kognito AI
# Installed at: ~/.local/bin/kognitoai
# Usage: kognitoai [install|start|stop|upgrade|status|setup]

KOGNITO_CONFIG="${HOME}/.kognito/config/.env"
REPO_URL="https://github.com/gatovillano/KognitoAI.git"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

# ── Resolve REPO_DIR ──────────────────────────────────────────────────────────
# Priority:
#   1. KOGNITO_REPO_DIR env var (user override)
#   2. Value stored in ~/.kognito/config/.env (written by installer)
#   3. Default fallback ~/KognitoAI

_load_repo_dir() {
    if [ -n "${KOGNITO_REPO_DIR:-}" ]; then
        echo "${KOGNITO_REPO_DIR}"
        return
    fi

    if [ -f "${KOGNITO_CONFIG}" ]; then
        local stored
        stored=$(grep -E '^KOGNITO_REPO_DIR=' "${KOGNITO_CONFIG}" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        if [ -n "${stored}" ]; then
            echo "${stored}"
            return
        fi
    fi

    echo "${HOME}/KognitoAI"
}

REPO_DIR="$(_load_repo_dir)"

# ── Helpers ───────────────────────────────────────────────────────────────────

show_help() {
    echo -e "${BOLD}Kognito AI CLI${NC}"
    echo ""
    echo -e "  ${GREEN}kognitoai install${NC}    - Instala Kognito AI desde GitHub en ~/KognitoAI"
    echo -e "  ${GREEN}kognitoai start${NC}      - Inicia todos los servicios"
    echo -e "  ${YELLOW}kognitoai upgrade${NC}    - Descarga la última versión y reinicia"
    echo -e "  ${BLUE}kognitoai setup${NC}      - Reconfigura el entorno de usuario (~/.kognito)"
    echo -e "  ${BLUE}kognitoai status${NC}     - Muestra el estado de los servicios"
    echo -e "  ${BLUE}kognitoai logs${NC}       - Muestra y monitorea los registros (logs) del sistema"
    echo -e "  ${RED}kognitoai stop${NC}       - Detiene todos los servicios"
    echo -e "  ${RED}kognitoai uninstall${NC}  - Desinstala Kognito AI"
    echo ""
    echo -e "  Instalación activa: ${BOLD}${REPO_DIR}${NC}"
    echo ""
}

_detect_branch() {
    git -C "${REPO_DIR}" symbolic-ref --short HEAD 2>/dev/null \
        || git ls-remote --symref "${REPO_URL}" HEAD \
            | awk '/^ref: refs\/heads\// {print $2}' \
            | sed 's/refs\/heads\///' \
        || echo "main"
}

check_repo() {
    if [ ! -d "${REPO_DIR}" ]; then
        echo -e "${YELLOW}⚠️  Kognito AI no está instalado en ${REPO_DIR}.${NC}"
        echo -e "${YELLOW}   Ejecuta: ${BOLD}kognitoai install${NC}"
        exit 1
    fi
}

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_install() {
    local BASE_DIR="${HOME}/KognitoAI"

    if [ -d "${BASE_DIR}" ]; then
        echo -e "${YELLOW}⚠️  El directorio ${BOLD}${BASE_DIR}${NC}${YELLOW} ya existe.${NC}"
        echo ""
        echo -e "  ${GREEN}1)${NC} Actualizar instalación existente (git pull)"
        echo -e "  ${BLUE}2)${NC} Crear nueva instancia paralela (${BASE_DIR}_1, _2…)"
        echo -e "  ${RED}3)${NC} Abortar"
        echo ""
        printf "  Selecciona una opción [1-3]: "
        read -r CHOICE

        case "${CHOICE}" in
            1)
                REPO_DIR="${BASE_DIR}"
                echo -e "${YELLOW}🔄 Actualizando repositorio existente...${NC}"
                git -C "${REPO_DIR}" pull
                ;;
            2)
                local COUNT=1
                while [ -d "${BASE_DIR}_${COUNT}" ]; do ((COUNT++)); done
                REPO_DIR="${BASE_DIR}_${COUNT}"
                echo -e "${YELLOW}🌐 Clonando rama ${BOLD}main${NC}${YELLOW} en ${REPO_DIR}...${NC}"
                git clone -b main "${REPO_URL}" "${REPO_DIR}"
                ;;
            *)
                echo "Instalación abortada."
                exit 1
                ;;
        esac
    else
        echo -e "${YELLOW}🌐 Clonando Kognito AI (rama: ${BOLD}main${NC}${YELLOW}) en ${BASE_DIR}...${NC}"
        git clone -b main "${REPO_URL}" "${BASE_DIR}"
        REPO_DIR="${BASE_DIR}"
    fi

    # Persist REPO_DIR to ~/.kognito/config/.env
    mkdir -p "${HOME}/.kognito/config"
    local env_file="${HOME}/.kognito/config/.env"
    if [ -f "${env_file}" ]; then
        # Update or append
        if grep -q '^KOGNITO_REPO_DIR=' "${env_file}"; then
            sed -i "s|^KOGNITO_REPO_DIR=.*|KOGNITO_REPO_DIR=${REPO_DIR}|" "${env_file}"
        else
            echo "KOGNITO_REPO_DIR=${REPO_DIR}" >> "${env_file}"
        fi
    else
        echo "KOGNITO_REPO_DIR=${REPO_DIR}" > "${env_file}"
    fi

    echo -e "${GREEN}✅ Instalación registrada en ${env_file}${NC}"
    echo -e "${YELLOW}⚙️  Ejecutando setup...${NC}"
    cd "${REPO_DIR}"
    exec bash install.sh
}

cmd_start() {
    check_repo
    echo -e "${GREEN}🚀 Iniciando Kognito AI desde ${REPO_DIR}...${NC}"
    cd "${REPO_DIR}"
    exec bash start_local.sh
}

cmd_upgrade() {
    check_repo
    echo -e "${YELLOW}🔄 Actualizando Kognito AI desde GitHub...${NC}"
    cd "${REPO_DIR}"

    local FORCE=false
    for arg in "$@"; do
        if [[ "$arg" == "--force" || "$arg" == "-f" ]]; then
            FORCE=true
        fi
    done

    local branch
    branch=$(_detect_branch)

    # Capturar commit anterior
    local OLD_HEAD
    OLD_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")

    # 1. Detectar extensiones activas
    if [ -f "scripts/upgrade_helper.py" ]; then
        echo -e "${YELLOW}🧩 Guardando estado de extensiones modulares...${NC}"
        python3 scripts/upgrade_helper.py --pre-upgrade
    fi

    # 2. Guardar cambios locales temporales con git stash (sin destruir archivos no rastreados)
    local STASHED=false
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
        echo -e "${YELLOW}📦 Guardando modificaciones locales (git stash)...${NC}"
        git stash push -m "kognitoai-upgrade-auto-stash" >/dev/null 2>&1 && STASHED=true
    fi

    echo -e "${BLUE}📥 Descargando cambios desde GitHub (rama ${branch})...${NC}"
    git pull origin "${branch}"

    if [ "${STASHED}" = true ]; then
        echo -e "${YELLOW}📦 Restaurando modificaciones locales (git stash pop)...${NC}"
        git stash pop >/dev/null 2>&1 || echo -e "${YELLOW}⚠️ Aviso: Revisa tu stash si hubieron conflictos menores.${NC}"
    fi

    # Capturar commit nuevo
    local NEW_HEAD
    NEW_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")

    # 3. Sincronizar extensiones activas (asegurar componentes presentes)
    local EXT_PROCESSED=false
    if [ -f "scripts/upgrade_helper.py" ]; then
        echo -e "${YELLOW}🧩 Sincronizando extensiones modulares...${NC}"
        local state_file="${HOME}/.kognito/config/active_extensions.json"
        if [ -f "${state_file}" ]; then
            EXT_PROCESSED=true
        fi
        python3 scripts/upgrade_helper.py --post-upgrade
    fi

    # 3.5. Ejecutar migraciones de base de datos si existen
    if [ -d "alembic" ] && [ -f "venv_host/bin/alembic" ]; then
        echo -e "${BLUE}🗄️  Verificando y aplicando migraciones de base de datos...${NC}"
        ./venv_host/bin/alembic upgrade head >/dev/null 2>&1 || true
        echo -e "${GREEN}✅ Base de datos al día.${NC}"
    fi

    # Determinar qué archivos cambiaron entre commits
    local CHANGED_FILES=""
    if [ -n "${OLD_HEAD}" ] && [ -n "${NEW_HEAD}" ] && [ "${OLD_HEAD}" != "${NEW_HEAD}" ]; then
        CHANGED_FILES=$(git diff --name-only "${OLD_HEAD}" "${NEW_HEAD}" 2>/dev/null || echo "")
    fi

    # 4. Dependencias de Python
    local REQ_CHANGED=false
    if echo "${CHANGED_FILES}" | grep -q "^requirements.txt$"; then
        REQ_CHANGED=true
    fi

    if [ "${FORCE}" = true ] || [ "${REQ_CHANGED}" = true ] || [ ! -d "venv_host" ]; then
        echo -e "${BLUE}🐍 Actualizando dependencias de Python...${NC}"
        if [ ! -d "venv_host" ]; then
            python3 -m venv venv_host
        fi
        ./venv_host/bin/pip install -r requirements.txt --quiet
        echo -e "${GREEN}✅ Python actualizado.${NC}"
    else
        echo -e "${GREEN}⚡ Sin cambios en requirements.txt. Omitiendo pip install.${NC}"
    fi

    # 5. Dependencias de Node
    local PKG_CHANGED=false
    if echo "${CHANGED_FILES}" | grep -E -q "^(package\.json|package-lock\.json)$"; then
        PKG_CHANGED=true
    fi

    if [ "${FORCE}" = true ] || [ "${PKG_CHANGED}" = true ] || [ ! -d "node_modules" ]; then
        echo -e "${BLUE}📦 Actualizando dependencias de Node...${NC}"
        npm install --silent
        echo -e "${GREEN}✅ Dependencias Node actualizadas.${NC}"
    else
        echo -e "${GREEN}⚡ Sin cambios en package.json/lock. Omitiendo npm install.${NC}"
    fi

    # 6. Reconstrucción de Frontend
    local FE_CHANGED=false
    if echo "${CHANGED_FILES}" | grep -E -q "^(src/|public/|package\.json|package-lock\.json|next\.config\.mjs|tsconfig\.json|tailwind\.config\.)"; then
        FE_CHANGED=true
    fi

    if [ "${FORCE}" = true ] || [ "${FE_CHANGED}" = true ] || [ "${EXT_PROCESSED}" = true ] || [ ! -d ".next" ] || [ ! -f ".next/BUILD_ID" ]; then
        echo -e "${YELLOW}🏗️  Reconstruyendo Frontend (npm run build)...${NC}"
        npm run build
        echo -e "${GREEN}✅ Frontend reconstruido exitosamente.${NC}"
    else
        echo -e "${GREEN}⚡ Sin cambios en el frontend. Omitiendo npm run build (usando build existente).${NC}"
    fi

    # Copiar binario CLI actualizado a ~/.local/bin/kognitoai si corresponde
    if [ -f "${HOME}/.local/bin/kognitoai" ]; then
        cp "${REPO_DIR}/kognitoai" "${HOME}/.local/bin/kognitoai" 2>/dev/null || true
        chmod +x "${HOME}/.local/bin/kognitoai" 2>/dev/null || true
    fi

    echo -e "${GREEN}✅ Actualización completada. Reiniciando...${NC}"
    exec bash start_local.sh
}

cmd_setup() {
    check_repo
    cd "${REPO_DIR}"
    exec bash setup.sh setup
}

cmd_status() {
    echo -e "${BOLD}Estado de Kognito AI:${NC}"
    echo -e "  Instalación: ${BLUE}${REPO_DIR}${NC}"
    echo ""
    echo -e "Contenedores Docker:"
    docker ps --format "  {{.Names}}\t{{.Status}}" 2>/dev/null | grep -E "kognito|kokoro" || echo "  (ninguno en ejecución)"
    echo ""
    echo -e "Servicios de aplicación:"
    pgrep -f "run_api.py" &>/dev/null && echo -e "  ${GREEN}✅ Backend API${NC}" || echo -e "  ${RED}❌ Backend API${NC}"
    pgrep -f "next" &>/dev/null && echo -e "  ${GREEN}✅ Frontend${NC}" || echo -e "  ${RED}❌ Frontend${NC}"
    pgrep -f "run_telegram_gateway" &>/dev/null && echo -e "  ${GREEN}✅ Telegram Gateway${NC}" || echo -e "  ${RED}❌ Telegram Gateway${NC}"
}

cmd_logs() {
    check_repo
    cd "${REPO_DIR}"
    
    local TARGET=""
    local LINES=50
    local FOLLOW=true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--lines)
                LINES="$2"
                shift 2
                ;;
            --no-follow)
                FOLLOW=false
                shift
                ;;
            -f|--follow)
                FOLLOW=true
                shift
                ;;
            list)
                TARGET="list"
                shift
                ;;
            clear)
                TARGET="clear"
                shift
                ;;
            *)
                TARGET="$1"
                shift
                ;;
        esac
    done

    mkdir -p logs

    case "${TARGET}" in
        list)
            echo -e "${BOLD}Archivos de log disponibles en ${REPO_DIR}/logs:${NC}"
            if ls -lh logs/*.log 2>/dev/null; then
                :
            else
                echo -e "${YELLOW}No se encontraron archivos de log en logs/${NC}"
            fi
            ;;
        clear)
            echo -e "${YELLOW}🧹 Limpiando archivos de log en ${REPO_DIR}/logs...${NC}"
            rm -f logs/*.log logs/*.out 2>/dev/null || true
            echo -e "${GREEN}✅ Logs limpiados.${NC}"
            ;;
        backend|api)
            local log_file="logs/backend.log"
            if [ ! -f "${log_file}" ]; then
                echo -e "${YELLOW}⚠️  El archivo ${log_file} no existe aún.${NC}"
                exit 1
            fi
            echo -e "${GREEN}📄 Mostrando registros de Backend (${log_file})...${NC}"
            if [ "${FOLLOW}" = true ]; then
                tail -n "${LINES}" -f "${log_file}"
            else
                tail -n "${LINES}" "${log_file}"
            fi
            ;;
        frontend|web|next)
            local log_file="logs/frontend.log"
            if [ ! -f "${log_file}" ]; then
                echo -e "${YELLOW}⚠️  El archivo ${log_file} no existe aún.${NC}"
                exit 1
            fi
            echo -e "${BLUE}📄 Mostrando registros de Frontend (${log_file})...${NC}"
            if [ "${FOLLOW}" = true ]; then
                tail -n "${LINES}" -f "${log_file}"
            else
                tail -n "${LINES}" "${log_file}"
            fi
            ;;
        telegram|gateway)
            local log_file="logs/telegram_gateway.log"
            if [ ! -f "${log_file}" ]; then
                echo -e "${YELLOW}⚠️  El archivo ${log_file} no existe aún.${NC}"
                exit 1
            fi
            echo -e "${YELLOW}📄 Mostrando registros de Telegram Gateway (${log_file})...${NC}"
            if [ "${FOLLOW}" = true ]; then
                tail -n "${LINES}" -f "${log_file}"
            else
                tail -n "${LINES}" "${log_file}"
            fi
            ;;
        llm)
            local latest_llm
            latest_llm=$(ls -t logs/llm_detailed_*.log 2>/dev/null | head -n 1)
            if [ -z "${latest_llm}" ]; then
                echo -e "${YELLOW}⚠️  No se encontraron registros de LLM (logs/llm_detailed_*.log).${NC}"
                exit 1
            fi
            echo -e "${GREEN}📄 Mostrando último registro de LLM (${latest_llm})...${NC}"
            if [ "${FOLLOW}" = true ]; then
                tail -n "${LINES}" -f "${latest_llm}"
            else
                tail -n "${LINES}" "${latest_llm}"
            fi
            ;;
        docker|db)
            if [ -f "docker-compose.yml" ]; then
                echo -e "${BLUE}📄 Mostrando registros de Docker Compose...${NC}"
                if [ "${FOLLOW}" = true ]; then
                    docker compose logs -f --tail="${LINES}" 2>/dev/null || docker-compose logs -f --tail="${LINES}"
                else
                    docker compose logs --tail="${LINES}" 2>/dev/null || docker-compose logs --tail="${LINES}"
                fi
            else
                echo -e "${YELLOW}⚠️  No se encontró docker-compose.yml en ${REPO_DIR}${NC}"
            fi
            ;;
        all|follow|live|stream|"")
            local active_logs=()
            [ -f "logs/backend.log" ] && active_logs+=("logs/backend.log")
            [ -f "logs/frontend.log" ] && active_logs+=("logs/frontend.log")
            [ -f "logs/telegram_gateway.log" ] && active_logs+=("logs/telegram_gateway.log")

            if [ ${#active_logs[@]} -eq 0 ]; then
                echo -e "${YELLOW}⚠️  No hay archivos de log activos en ${REPO_DIR}/logs.${NC}"
                echo -e "${YELLOW}   Ejecuta: ${BOLD}kognitoai start${NC} para iniciar los servicios.${NC}"
                exit 1
            fi

            echo -e "${GREEN}📄 Mostrando registros en tiempo real (${active_logs[*]})...${NC}"
            if [ "${FOLLOW}" = true ]; then
                tail -n "${LINES}" -f "${active_logs[@]}"
            else
                tail -n "${LINES}" "${active_logs[@]}"
            fi
            ;;
        *)
            echo -e "${RED}Opción o servicio de logs desconocido: '${TARGET}'${NC}"
            echo ""
            echo -e "${BOLD}Uso de kognitoai logs:${NC}"
            echo -e "  kognitoai logs [all]                  - Visualiza logs de todos los servicios activos"
            echo -e "  kognitoai logs backend | frontend | telegram | llm | docker"
            echo -e "  kognitoai logs list                   - Lista los archivos de logs disponibles"
            echo -e "  kognitoai logs clear                  - Borra los archivos de logs"
            echo -e "  Opciones: -n <líneas> / --no-follow"
            exit 1
            ;;
    esac
}

cmd_stop() {
    echo -e "${RED}🛑 Deteniendo servicios de Kognito AI...${NC}"
    pkill -f "run_api.py" 2>/dev/null && echo "  Backend detenido." || true
    pkill -f "run_telegram_gateway" 2>/dev/null && echo "  Telegram Gateway detenido." || true
    pkill -f "next-server" 2>/dev/null && echo "  Frontend detenido." || true
    echo -e "${GREEN}✅ Todos los servicios detenidos.${NC}"
}

cmd_uninstall() {
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}⚠️  Desinstalación de Kognito AI${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  Instalación activa: ${BOLD}${REPO_DIR}${NC}"
    echo ""

    # 1. Stop services first
    echo -e "${YELLOW}🛑 Deteniendo servicios en ejecución...${NC}"
    pkill -f "run_api.py" 2>/dev/null && echo "  Backend detenido." || true
    pkill -f "run_telegram_gateway" 2>/dev/null && echo "  Telegram Gateway detenido." || true
    pkill -f "next-server" 2>/dev/null && echo "  Frontend detenido." || true

    # 2. Stop Docker containers
    if [ -d "${REPO_DIR}" ] && [ -f "${REPO_DIR}/docker-compose.yml" ]; then
        echo -e "${YELLOW}🐳 Deteniendo contenedores Docker...${NC}"
        docker compose -f "${REPO_DIR}/docker-compose.yml" down 2>/dev/null || true
    fi

    # 3. Remove repo directory
    if [ -d "${REPO_DIR}" ]; then
        printf "  ¿Eliminar directorio del repositorio ${BOLD}${REPO_DIR}${NC}? [s/N]: "
        read -r CONFIRM_REPO
        if [[ "${CONFIRM_REPO}" =~ ^[sS]$ ]]; then
            rm -rf "${REPO_DIR}"
            echo -e "${GREEN}✅ Repositorio eliminado.${NC}"
        else
            echo -e "${YELLOW}   Repositorio conservado.${NC}"
        fi
    fi

    # 4. Remove user data (~/.kognito)
    if [ -d "${HOME}/.kognito" ]; then
        echo ""
        echo -e "  ${RED}⚠️  ${HOME}/.kognito contiene tus datos de usuario (skills, media, configuración).${NC}"
        printf "  ¿Eliminar datos de usuario ${BOLD}~/.kognito${NC}? [s/N]: "
        read -r CONFIRM_DATA
        if [[ "${CONFIRM_DATA}" =~ ^[sS]$ ]]; then
            rm -rf "${HOME}/.kognito"
            echo -e "${GREEN}✅ Datos de usuario eliminados.${NC}"
        else
            echo -e "${YELLOW}   Datos de usuario conservados en ~/.kognito${NC}"
            # Just remove the KOGNITO_REPO_DIR entry from the config
            local env_file="${HOME}/.kognito/config/.env"
            if [ -f "${env_file}" ]; then
                sed -i '/^KOGNITO_REPO_DIR=/d' "${env_file}"
            fi
        fi
    fi

    # 5. Remove CLI binary
    local cli_bin="${HOME}/.local/bin/kognitoai"
    if [ -f "${cli_bin}" ]; then
        printf "  ¿Eliminar el comando 'kognitoai' de ${cli_bin}? [s/N]: "
        read -r CONFIRM_CLI
        if [[ "${CONFIRM_CLI}" =~ ^[sS]$ ]]; then
            rm -f "${cli_bin}"
            echo -e "${GREEN}✅ Comando 'kognitoai' eliminado.${NC}"
        else
            echo -e "${YELLOW}   CLI conservado.${NC}"
        fi
    fi

    echo ""
    echo -e "${GREEN}✅ Desinstalación completada.${NC}"
}

# ── Main dispatcher ───────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift 2>/dev/null || true
case "${COMMAND}" in
    install)   cmd_install "$@" ;;
    start)     cmd_start "$@" ;;
    upgrade)   cmd_upgrade "$@" ;;
    setup)     cmd_setup "$@" ;;
    status)    cmd_status "$@" ;;
    logs)      cmd_logs "$@" ;;
    stop)      cmd_stop "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    *)         show_help "$@" ;;
esac
