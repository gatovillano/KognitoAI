
# =================================================================
# 🔊 TEXT-TO-SPEECH (TTS) CONFIGURATION
# =================================================================

# Google Cloud Text-to-Speech Settings
TTS_CACHE_ENABLED=True
TTS_CACHE_DIR=/tmp/tts_cache
TTS_CACHE_MAX_AGE_DAYS=30
TTS_DEFAULT_VOICE=es-MX-DaliaNeural
TTS_DEFAULT_SPEAKING_RATE=1.0

# Google Cloud credentials (required for TTS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =================================================================
# KognitoAI Agent Configuration
# =================================================================

# =================================================================
# 🤖 AI MODELS & LLM CONFIGURATION
# =================================================================

# Google AI Configuration (Primary)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_PROJECT_ID=your_google_cloud_project_id
GOOGLE_PROJECT_LOCATION=us-central1

# Google Model Names (Gemini & Vertex AI)
GOOGLE_MAIN_MODEL_NAME=gemini-2.0-flash
GOOGLE_SUMMARY_MODEL_NAME=gemini-2.5-flash
GOOGLE_IMAGE_GENERATION_MODEL_NAME=imagegeneration@006
GOOGLE_EMBEDDING_MODEL_NAME=text-embedding-004
# Dispositivo para SentenceTransformer local (ej. cpu, cuda, mps).
# Si se deja vacío o no se define, se autodetectará GPU si está disponible.
EMBEDDING_DEVICE=cpu

# LLM Parameters
LLM_TEMPERATURE=0.4
LLM_REQUEST_TIMEOUT=300
LLM_MAX_RETRIES=3
MAX_AGENT_LOOPS=20

# Kilocode Gateway Configuration
KILOCODE_API_KEY=your_kilocode_api_key_here
# Ollama Configuration (Alternative/Local)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_API_URL=http://196.168.100.106:11434

# =================================================================
# 📱 TELEGRAM BOT CONFIGURATION
# =================================================================

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username

# Telegram Web App URL
TELEGRAM_WEBAPP_URL=https://your-webapp-url.com

# Admin Configuration (comma-separated Telegram User IDs)
ADMIN_TELEGRAM_IDS=123456789,987654321

# Telegram Bot Service URL
TELEGRAM_BOT_URL=http://telegram_client:9090

# =================================================================
# 🛢️ DATABASE CONFIGURATION
# =================================================================

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kognito_db

# Complete Database URL (constructed automatically in docker-compose)
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password_here@db:5432/kognito_db

# =================================================================
# 🔐 SECURITY & AUTHENTICATION
# =================================================================

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRY_DAYS=0

# Admin Secret for API endpoints
ADMIN_SECRET=your_admin_secret_here

# Internal API Key for Bot Communication
INTERNAL_API_KEY_FOR_BOT=your_internal_api_key_here

# =================================================================
# 🌐 EXTERNAL SERVICES & APIs
# =================================================================

# Brave Search API (for web search functionality)
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# API Server URL
API_SERVER_URL=http://core:8080

# =================================================================
# 🧠 KNOWLEDGE GRAPH & COGNEE CONFIGURATION
# =================================================================

# Neo4j Database (for Knowledge Graphs)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Cognee API Configuration (optional - uses library directly)
COGNEE_API_URL=http://localhost:8000

# =================================================================
# 📄 RAG & DOCUMENT PROCESSING
# =================================================================

# Document Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Proactive Analysis Thresholds
DUPLICITY_SIMILARITY_THRESHOLD=0.90
SYNERGY_SIMILARITY_THRESHOLD=0.65
CONTRADICTION_SENTIMENT_THRESHOLD=0.70
EVOLUTION_MIN_DAYS_THRESHOLD=30

# =================================================================
# 🐳 DOCKER & DEPLOYMENT
# =================================================================

# Media directories
MEDIA_ROOT=media/documents
THUMBNAILS_ROOT=media/thumbnails

# Port Configuration
API_PORT=8889
FRONTEND_PORT=8880

# PGAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@kognito.local
PGADMIN_DEFAULT_PASSWORD=admin123

# =================================================================
# 🛠️ DEVELOPMENT & DEBUGGING
# =================================================================

# Debug Mode
DEBUG_MODE=false

# =================================================================
# 📝 OPTIONAL: CUSTOM SYSTEM PROMPT
# =================================================================

# Leave empty to use default system prompt, or customize here
# DEFAULT_SYSTEM_PROMPT=""

# =================================================================
# IMPORTANT NOTES:
# =================================================================
# 1. Replace all placeholder values (your_*_here) with actual values
# 2. Keep this file secure and never commit real credentials to version control
# 3. For production, use strong passwords and secure API keys
# 4. Ensure all critical variables are set before running the agent
# 5. Some variables have defaults but it's recommended to set them explicitly
