# Dockerfile.core.hybrid
# Versión optimizada que incluye dependencias para pipeline híbrido sin problemas de build

FROM nvcr.io/nvidia/pytorch:23.09-py3

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PYTHONPATH /app:/app/external_agents/open_deep_research/src
ENV PATH="/usr/bin:$PATH"

# Instalar dependencias del sistema esenciales (algunas ya estarán en la imagen de PyTorch, pero las mantenemos por si acaso)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    wget \
    gcc \
    g++ \
    python3-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements y usar instalación por etapas
COPY requirements.txt ./

# Instalar dependencias básicas primero (más estables)
RUN pip install --no-cache-dir --timeout 300 --retries 3 -r requirements.txt

# Copiar código
COPY . .

# Script de inicialización que descarga modelos faltantes
RUN echo '#!/bin/bash\n\
# Descargar modelos faltantes al iniciar el contenedor\n\
python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer(\"paraphrase-multilingual-MiniLM-L12-v2\")" 2>/dev/null || echo "SentenceTransformers will download on first use"\n\
exec "$@"' > /app/init.sh && chmod +x /app/init.sh

EXPOSE 8000

# Usar script de inicialización
ENTRYPOINT ["/app/init.sh"]
CMD ["uvicorn", "run_api:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
