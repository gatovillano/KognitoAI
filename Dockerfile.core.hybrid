# Dockerfile.core.hybrid
# Versión optimizada que incluye dependencias para pipeline híbrido sin problemas de build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PYTHONPATH /app:/app/external_agents/open_deep_research/src

# Instalar dependencias del sistema esenciales
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    wget \
    gcc \
    g++ \
    ffmpeg \
    libcairo2 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements
COPY requirements.txt ./

# Instalar PyTorch y dependencias de NVIDIA por separado
RUN pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Anular posibles restricciones de la imagen base
ENV PIP_CONSTRAINT=""

# Instalar dependencias en etapas para evitar conflictos de resolución
# Forzamos la actualización de requests primero para que coincida con lo que pide langchain-community
RUN pip install --no-cache-dir --timeout 300 --retries 3 --upgrade pip setuptools wheel

RUN pip install --no-cache-dir --timeout 300 --retries 3 \
    --upgrade 'requests>=2.32.5' 'langchain-core>=0.3.74' 'langchain>=0.3.27' 'langchain-community>=0.3.27' 'langgraph>=0.2.65' 'langgraph-prebuilt>=0.1.0'

# Instalar todas las dependencias desde requirements.txt
RUN pip install --no-cache-dir --timeout 300 --retries 3 -r requirements.txt

# Etapa 4: Paquetes grandes de ML/NLP y asegurar LangGraph
RUN pip install --no-cache-dir --timeout 300 --retries 3 \
    spacy>=3.7.0 \
    transformers>=4.30.0 \
    'langgraph>=0.2.65' \
    'langgraph-prebuilt>=0.1.0'

# Verificación de instalación de LangGraph (fallará el build si no está bien instalado)
RUN python -c "import langgraph; from langgraph.prebuilt import ToolNode; print('✅ LangGraph y su módulo prebuilt están disponibles')"

# Instalar modelo de spaCy
RUN python -m pip install https://github.com/explosion/spacy-models/releases/download/es_core_news_sm-3.7.0/es_core_news_sm-3.7.0-py3-none-any.whl

# Pre-descargar el modelosigue sin  de embeddings interno para autonomía total (Sentence Transformers)
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/paraphrase-multilingual-mpnet-base-v2')"

# Copiar código
COPY . .

EXPOSE 8000

CMD ["uvicorn", "run_api:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gen-lang-client-0283065579-148403406341.json
