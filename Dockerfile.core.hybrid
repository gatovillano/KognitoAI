# Dockerfile.core.hybrid
# Versión optimizada que incluye dependencias para pipeline híbrido sin problemas de build

FROM nvcr.io/nvidia/pytorch:25.03-py3

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1
ENV PYTHONPATH /app:/app/external_agents/open_deep_research/src

# Instalar dependencias del sistema esenciales (algunas ya estarán en la imagen de PyTorch, pero las mantenemos por si acaso)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    wget \
    gcc \
    g++ \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar requirements
COPY requirements.txt ./

# Instalar dependencias en etapas para evitar conflictos de resolución
# Etapa 1: Core frameworks y base de datos
RUN pip install --no-cache-dir --timeout 300 --retries 3 \
    fastapi>=0.100.0 \
    uvicorn>=0.20.0 \
    sqlalchemy[asyncio]>=2.0.0 \
    psycopg[async]>=3.1.0 \
    psycopg2-binary>=2.9.0 \
    alembic>=1.12.0 \
    pydantic[email]>=2.0.0

# Etapa 3: Instalación de todas las dependencias desde requirements.txt
# Desinstalamos requests primero para evitar conflictos con la versión preinstalada en la imagen base
RUN pip uninstall -y requests && \
    pip install --no-cache-dir --timeout 300 --retries 3 -r requirements.txt

# Etapa 4: Paquetes grandes de ML/NLP (instalar al final para evitar conflictos)
RUN pip install --no-cache-dir --timeout 300 --retries 3 \
    spacy>=3.7.0 \
    transformers>=4.30.0

# Instalar modelo de spaCy
RUN python -m pip install https://github.com/explosion/spacy-models/releases/download/es_core_news_sm-3.7.0/es_core_news_sm-3.7.0-py3-none-any.whl


# Copiar código
COPY . .

EXPOSE 8000

CMD ["uvicorn", "run_api:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
ENV GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gen-lang-client-0283065579-148403406341.json
