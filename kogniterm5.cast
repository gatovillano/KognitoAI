[156.659, "o", "\u001b[31;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;66;146;166;48;2;25;26;33m 5 \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33mLas pruebas existentes se dividen en tres categorías: algunas usan \u001b[0m\u001b[1;38;2;66;146;163;48;2;26;26;26masyncio\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m directamente \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[31;111H\u001b[38;2;68;71;90;48;2;0;0;0m▄\u001b[0m\u001b[31;112H\r\n\u001b[32;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;66;146;166;48;2;25;26;33m   \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33msin marco de prueba asíncrono, otras dependen de módulos que no están instalados como   \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[32;111H\u001b[7;38;2;68;71;90;48;2;25;26;33m \u001b[0m\u001b[32;112H\r\n\u001b[33;10H\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;66;146;166;48;2;25;26;33m   \u001b[0m\u001b[1;38;2;66;146;163;48;2;26;26;26mneo4j\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m y \u001b[0m\u001b[1;38;2;66;146;163;48;2;26;26;26mfitz\u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m, y unas pocas aprovechan `                                                 \u001b[0m\u001b[38;2;73;84;119;48;2;25;26;33m    \u001b[0m\u001b[38;2;34;36;46;48;2;25;26;33m│\u001b[0m\u001b[33;111H\u001b[7;38;2;68;71;90;48;2;25;26;33m \u001b[0m\u001b[33;112H\r\n\u001b[34;10H\u001b[38;2;34;36;46;48;2;25;26;33m╰───────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\u001b[34;111H\u001b[7;38;2;68;71;90;48;2;25;26;33m \u001b[0m\u001b[34;112H\r\n\u001b[35;10H\u001b[38;2;248;248;242;48;2;25;26;33m                                                                                 