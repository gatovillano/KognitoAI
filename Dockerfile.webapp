# Dockerfile.webapp

FROM python:3.11-slim

# Instalar dependencias del sistema necesarias para pgvector y otras librerías
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    build-essential \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar el archivo de requerimientos primero para aprovechar la caché de Docker
COPY requirements.webapp.txt .
RUN pip install --no-cache-dir -r requirements.webapp.txt

# Copiar todo el código del proyecto. El servidor necesita acceso a telegram_bot/, utils/, etc.
COPY . .

EXPOSE 8000

# Comando para iniciar el servidor FastAPI con Uvicorn
CMD ["uvicorn", "web_server:app", "--host", "0.0.0.0", "--port", "8000"]