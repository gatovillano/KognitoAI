# Dockerfile.telegram
# Construye la imagen para el servicio 'telegram_client'.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# ¡IMPORTANTE! Instala TODAS las dependencias del sistema necesarias.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Usa el archivo de requerimientos específico para telegram_client.
COPY requirements.complete.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
RUN pip install --no-cache-dir --timeout 600 --retries 3 --index-url https://pypi.org/simple/ -r requirements.complete.txt

COPY . .

# Ejecuta el lanzador del bot de Telegram.
CMD ["python", "run_telegram_bot.py"]
